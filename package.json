{
  "name": "commercial-assistant-ai",
  "private": true,
  "version": "0.1.7",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "setup": "tsx scripts/setup-installation.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate-from-json": "tsx prisma/migrate-from-json.ts",
    "prisma:seed": "tsx prisma/seed.ts",
    "regression:approval-rbac": "bash scripts/regression-approval-rbac.sh",
    "regression:workspace-documents": "bash scripts/regression-workspace-documents.sh",
    "regression:admin-console": "bash scripts/regression-admin-console.sh",
    "capture:ui": "tsx scripts/capture-ui.ts",
    "test:visual": "playwright test",
    "audit:contrast": "tsx scripts/audit-contrast.ts",
    "capture:manuals": "tsx scripts/capture-manuals.ts",
    "provision:manual-capture": "tsx scripts/provision-manual-capture-user.ts"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "postcss": {
      ".": "^8.5.18",
      "nanoid": "^3.3.18"
    },
    "brace-expansion": "^5.0.9",
    "deepmerge-ts": "^8.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.1084.0",
    "@google-cloud/storage": "^7.14.0",
    "@google/genai": "^2.4.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^6.0.3",
    "docxtemplater": "^3.69.3",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.18.1",
    "lucide-react": "^1.24.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "openai": "^6.45.0",
    "otplib": "^13.4.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pizzip": "^3.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
