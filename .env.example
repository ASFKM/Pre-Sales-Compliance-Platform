# Required for Gemini AI API calls.
# In Google AI Studio, configure this through the Secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public application URL used for callbacks and self-referential links.
APP_URL="http://localhost:3000"

# Runtime
NODE_ENV="development"
PORT="3000"

# Security placeholders for production hardening
SESSION_SECRET="change-me"
ENCRYPTION_KEY="change-me-32-byte-key"

# Storage mode: local | s3 | gcs
STORAGE_MODE="local"
LOCAL_STORAGE_PATH="./uploads"

# Optional cloud storage placeholders
AWS_REGION=""
AWS_S3_BUCKET=""
GOOGLE_CLOUD_PROJECT=""
GCS_BUCKET=""

# Optional future providers
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
