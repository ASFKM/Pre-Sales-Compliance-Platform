# Server
PORT=3000
APP_URL="http://localhost:3000"

# Runtime mode
# Use demo only for prototype/local validation - enables demo login and the demo MFA fallback
# codes (123456/000000/111111) for accounts without an enrolled TOTP secret.
# Use production for real operation - production hard-blocks both of those. See SECURITY.md.
APP_RUNTIME_MODE=demo
VITE_APP_RUNTIME_MODE=demo
ENABLE_DEMO_LOGIN=true
ENABLE_DEMO_MFA=true
SESSION_TTL_MINUTES=60
COOKIE_SECURE=false

# Required production secrets - generate with `openssl rand -hex 32`
SECRET_ENCRYPTION_KEY="CHANGE_ME_32_BYTES_MINIMUM"
JWT_SESSION_SECRET="CHANGE_ME_STRONG_SESSION_SECRET"

# Database (required) - PostgreSQL via Prisma
DATABASE_URL="postgresql://app_user:CHANGE_ME@localhost:5432/commercial_assistant"
# DATABASE_SSL_CA_PATH=/path/to/ca.crt

# Redis (required) - sessions and short-lived caches
REDIS_URL="redis://:CHANGE_ME@localhost:6379/0"
# REDIS_SSL_CA_PATH=/path/to/ca.crt

# File storage: local, s3, or gcs. Only the local mode needs no further config below - the
# storage directory itself is a database setting (Admin > Settings > Storage), not an env var.
STORAGE_MODE=local

# Only if STORAGE_MODE=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_S3_BUCKET=my-presales-tender-bucket

# Only if STORAGE_MODE=gcs
# GCS_PROJECT_ID=
# GCS_KEY_FILE_PATH=/app/secrets/gcs_key.json
# GCS_BUCKET_NAME=my-presales-tender-bucket

# AI provider keys - optional at the environment level. Providers/models are normally configured
# and their keys stored (encrypted) per tenant from Admin > IA, Prompts e Custos, independently
# per task type. Setting one here is only useful as a first-boot fallback.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optional: extra trusted CA bundle (corporate proxies / private CAs)
# NODE_EXTRA_CA_CERTS=/path/to/extra-ca-bundle.pem

# Only used by docker-compose.yml, not read directly by the app
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=
# MINIO_ROOT_PASSWORD=
