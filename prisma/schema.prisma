generator client {
  provider = "prisma-client-js"
}

// The installed Prisma CLI is 6.19.3, not 7 - prisma.config.ts's datasource.url override (a
// Prisma 7 API) is silently not honored by this version, so `prisma generate`/`migrate` need the
// url declared here too (confirmed: without it, `npm ci`'s postinstall `prisma generate` step
// fails with "Argument url is missing", breaking CI and any fresh install). The runtime client
// still gets its connection separately via the @prisma/adapter-pg driver adapter in
// src/prisma.ts, so this has no effect on the running app - CLI-only.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum DeploymentMode {
  saas
  onprem
}

enum TenantStatus {
  active
  suspended
}

enum Language {
  Portuguese
  English
  Spanish
}

enum ProjectStatus {
  draft
  analysis_in_progress
  waiting_customer
  waiting_internal
  completed
  canceled
}

// Add-on module (Fase 6 do roadmap) - only meaningful for tenants whose Fleet Manager
// ModuleEntitlement includes "poc" (see server/utils/fleetLicense.ts). Mirrors the funnel a
// presales team actually runs a proof of concept through, ending in a recorded customer decision.
// Fase K (2026-07-14): won/lost dropped as separate statuses - that outcome already lives on
// PocAcceptance.decision (set by the acceptance workflow itself), so the pipeline only needs one
// terminal "completed" stage. "not_started" is a new default stage before a POC is actually
// planned (dates/kickoff defined) - previously every new POC started life as "planned" even before
// that was true.
enum PocStatus {
  not_started
  planned
  in_progress
  blocked
  completed
}

// Fase 6 (add-on), Fase C: tracked separately from PocStatus - equipment can still be sitting at
// the customer's site after the POC itself wraps up, which is exactly the risk this exists to
// surface (see the overdue-return alert built on top of this in the API/UI).
enum PocEquipmentStatus {
  shipped
  at_customer
  returned
}

enum PocTaskStatus {
  planned
  in_progress
  done
}

enum PocTestCaseStatus {
  pending
  in_progress
  approved
  failed
}

enum PocAcceptanceDecision {
  pending
  won
  lost
}

enum StorageProvider {
  local
  s3
  gcs
}

enum AnalysisJobStatus {
  idle
  running
  completed
  failed
}

enum BackgroundTaskType {
  document_analysis
  proposal_generation
  project_intake_analysis
  knowledge_base_analysis
  poc_test_generation
  poc_schedule_generation
  // Roadmap item: focused single-section re-run of an already-completed analysis (e.g. just the
  // BOM) when a section comes out unsatisfactory - reuses document_analysis's own provider/model
  // config (same AI capability, just a narrower prompt), but needs its own type so the UI/progress
  // label can distinguish "rerunning one section" from "running the full 8-section analysis".
  section_reanalysis
  // Roadmap item (official): "Pareceres de IA Multi-Perspectiva em Propostas" - 4 opinions
  // (Technical/Commercial/Legal/Financial) generated sequentially as one background task, results
  // persisted in ProposalOpinionRun/ProposalAiOpinionItem (unlike the synchronous, unpersisted
  // sla-risk-check) so the panel survives a page reload, attached to the proposal.
  proposal_opinion_panel
  // Sistema de Atualização de Produção: the actual scripts/update.sh run, tracked here so the
  // Admin Console's history reuses the same progress-tracking UI as every other background task.
  // NOT tenant-scoped in spirit (a real update restarts the whole server process, affecting every
  // tenant) even though the column is still required - see the comment on SystemUpdateState for
  // why tenantId is kept anyway. triggered by schedule or a CMSaaS apply_update command, not a
  // live HTTP request, so userId is null for those - see BackgroundTask.userId's own comment.
  system_update
}

enum BackgroundTaskStatus {
  queued
  running
  completed
  failed
}

enum ReviewStatus {
  pending
  reviewed
  approved
}

enum ConversationRole {
  user
  model
}

enum LogLevel {
  TRACE
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}

enum ProposalTemplateType {
  technical
  commercial
  technical_commercial
  executive_summary
  risk_report
  bom_report
  questions_report
}

enum ProposalFileType {
  docx
  doc
  pdf
}

enum ProposalType {
  technical
  commercial
  technical_commercial
  executive_summary
  risk_report
  bom_report
  questions_report
}

enum ProposalStatus {
  draft
  submitted
  approved
  rejected
  released
}

enum ApproverType {
  user
  role
}

enum ApprovalDecisionType {
  approved
  rejected
}

enum TaskStatus {
  open
  in_progress
  waiting_customer
  waiting_internal
  completed
  canceled
}

enum Priority {
  high
  medium
  low
}

enum IntegrationStatus {
  connected
  disconnected
  error
}

enum Theme {
  light
  dark
}

model Tenant {
  id             String         @id
  name           String
  deploymentMode DeploymentMode @default(onprem) @map("deployment_mode")
  status         TenantStatus   @default(active)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  users                   User[]
  roles                   Role[]
  projects                Project[]
  documents               Document[]
  documentContents        DocumentContent[]
  backgroundTasks         BackgroundTask[]
  analysisJobs            AIAnalysisJob[]
  analysisResults         AnalysisResult[]
  conversationMessages    ConversationMessage[]
  auditLogs               AuditLog[]
  debugLogs               DebugLog[]
  platformSettings        PlatformSettings?
  promptTemplates         PromptTemplate[]
  proposalTemplates       ProposalTemplate[]
  verticals               Vertical[]
  systemMessages          SystemMessage[]
  proposals               Proposal[]
  approvalWorkflows       ApprovalWorkflow[]
  approvalStages          ApprovalStage[]
  approvalDecisions       ApprovalDecision[]
  proposalOpinionRuns     ProposalOpinionRun[]
  proposalAiOpinionItems  ProposalAiOpinionItem[]
  tasks                   Task[]
  brandingSettings        BrandingSettings?
  brandStyles             BrandStyle[]
  teamMemberships         TeamMembership[]
  integrationConnectors   IntegrationConnector[]
  knowledgeBaseDocuments  KnowledgeBaseDocument[]
  knowledgeBaseEntries    KnowledgeBaseEntry[]
  aiUsageLogs             AiUsageLog[]
  aiProviderConfigs       AiProviderConfig[]
  pocs                    Poc[]
  pocSuccessCriteria      PocSuccessCriterion[]
  pocEquipmentItems       PocEquipmentItem[]
  pocTasks                PocTask[]
  pocTestCases            PocTestCase[]
  pocAcceptances          PocAcceptance[]
  pocFinalReportQuestions PocFinalReportQuestion[]
  iaKbBillingSnapshot     IaKbBillingSnapshot?
  iaKbTaskConfigs         IaKbTaskConfig[]
  systemUpdateState       SystemUpdateState?
  systemUpdateHistory     SystemUpdateHistory[]

  // Módulo de Precificação (add-on)
  priceCatalogItems      PriceCatalogItem[]
  priceListUploads       PriceListUpload[]
  priceHistoryEntries    PriceHistoryEntry[]
  itemAliasMappings      ItemAliasMapping[]
  projectPricingSheets   ProjectPricingSheet[]
  projectPricingLines    ProjectPricingLine[]
  budgetOptimizationRuns BudgetOptimizationRun[]
  tenantPricingSettings  TenantPricingSettings?
  tenantTaxProfile       TenantTaxProfile?

  @@map("tenants")
}

model User {
  id                 String     @id
  tenantId           String     @map("tenant_id")
  tenant             Tenant     @relation(fields: [tenantId], references: [id])
  name               String
  email              String     @unique
  passwordHash       String?    @map("password_hash")
  mfaEnabled         Boolean    @default(false) @map("mfa_enabled")
  mfaTotpSecret      String?    @map("mfa_totp_secret")
  // Roadmap (segurança): sempre true na criação, ou quando o admin redefine a senha de um usuário
  // que a perdeu - bloqueia todas as rotas exceto POST /api/auth/change-password até ser zerado.
  // Mesmo padrão estrutural de gate que mfaEnabled/session.mfaVerified já usa (ver requireAuth).
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  status             UserStatus @default(ACTIVE)
  roleId             String     @map("role_id")
  role               Role       @relation(fields: [roleId], references: [id])
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  lastLoginAt        DateTime?  @map("last_login_at")

  ownedProjects    Project[]        @relation("ProjectOwner")
  managedEngineers TeamMembership[] @relation("TeamManager")
  teamMemberships  TeamMembership[] @relation("TeamEngineer")
  ownedPocs        Poc[]            @relation("PocOwner")

  // Módulo de Precificação (add-on)
  priceListUploads       PriceListUpload[]
  budgetOptimizationRuns BudgetOptimizationRun[]

  @@index([tenantId])
  @@map("users")
}

// N:N, not a simple "reports to" column - an Engineer can belong to more than one Manager's
// team (confirmed: multiple Managers run separate teams that can overlap).
model TeamMembership {
  id         String   @id
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  managerId  String   @map("manager_id")
  manager    User     @relation("TeamManager", fields: [managerId], references: [id])
  engineerId String   @map("engineer_id")
  engineer   User     @relation("TeamEngineer", fields: [engineerId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([managerId, engineerId])
  @@index([tenantId])
  @@map("team_memberships")
}

model Role {
  id          String   @id
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  description String
  permissions String[]

  users User[]

  @@index([tenantId])
  @@map("roles")
}

model Project {
  id                         String        @id
  tenantId                   String        @map("tenant_id")
  tenant                     Tenant        @relation(fields: [tenantId], references: [id])
  name                       String
  customerName               String        @map("customer_name")
  opportunityName            String        @map("opportunity_name")
  vertical                   String
  description                String
  status                     ProjectStatus
  deadline                   DateTime
  proposalValidityDate       DateTime      @map("proposal_validity_date")
  ownerUserId                String        @map("owner_user_id")
  owner                      User          @relation("ProjectOwner", fields: [ownerUserId], references: [id])
  outputLanguage             Language      @map("output_language")
  proposalLanguage           Language      @map("proposal_language")
  aiOrientationMode          String        @map("ai_orientation_mode")
  aiOrientationText          String        @map("ai_orientation_text") @db.Text
  selectedApprovalWorkflowId String?       @map("selected_approval_workflow_id")
  // Roadmap item (customer_request): "Identidade Visual em DOCX" Fase 4b - a project/client can
  // override the tenant-wide BrandingSettings (logo + primary color) with a reusable named
  // BrandStyle for co-branded proposals. Null = use the tenant default, unchanged from before.
  brandStyleId               String?       @map("brand_style_id")
  procurementModality        String?       @map("procurement_modality")
  procurementSubtype         String?       @map("procurement_subtype")
  customModality             String?       @map("custom_modality")
  createdAt                  DateTime      @default(now()) @map("created_at")
  updatedAt                  DateTime      @updatedAt @map("updated_at")

  documents           Document[]
  analysisJobs        AIAnalysisJob[]
  analysisResults     AnalysisResult[]
  proposals           Proposal[]
  tasks               Task[]
  conversationHistory ConversationMessage[]
  pocs                Poc[]
  pricingSheets       ProjectPricingSheet[]

  @@index([tenantId])
  @@map("projects")
}

// Fase 6 (add-on): a POC either hangs off an existing Project/opportunity (inheriting its
// customer/vertical/owner) or stands alone for exploratory evaluations that don't have a formal
// opportunity yet - hence projectId is nullable and the standalone* fields exist as a fallback
// customer record, mirroring the same shape Project already uses instead of inventing a new one.
model Poc {
  id                     String    @id
  tenantId               String    @map("tenant_id")
  tenant                 Tenant    @relation(fields: [tenantId], references: [id])
  projectId              String?   @map("project_id")
  project                Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  standaloneCustomerName String?   @map("standalone_customer_name")
  standaloneContactName  String?   @map("standalone_contact_name")
  standaloneContactEmail String?   @map("standalone_contact_email")
  standaloneContactPhone String?   @map("standalone_contact_phone")
  name                   String
  objective              String    @db.Text
  status                 PocStatus @default(not_started)
  archived               Boolean   @default(false)
  startDate              DateTime  @map("start_date")
  endDate                DateTime  @map("end_date")
  ownerUserId            String    @map("owner_user_id")
  owner                  User      @relation("PocOwner", fields: [ownerUserId], references: [id])
  customerContactName    String    @map("customer_contact_name")
  customerContactRole    String    @map("customer_contact_role")

  // Fase J: where the POC actually happens - same field set already used by Customer in the
  // CMSaaS (fleet-manager), so this doesn't invent a new address shape. All optional: a POC's
  // location may not be known yet at creation time, and a standalone POC has no Project address to
  // fall back on.
  addressZip          String? @map("address_zip")
  addressStreet       String? @map("address_street")
  addressNumber       String? @map("address_number")
  addressComplement   String? @map("address_complement")
  addressNeighborhood String? @map("address_neighborhood")
  addressCity         String? @map("address_city")
  addressState        String? @map("address_state")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  successCriteria      PocSuccessCriterion[]
  equipmentItems       PocEquipmentItem[]
  tasks                PocTask[]
  testCases            PocTestCase[]
  acceptance           PocAcceptance?
  finalReportQuestions PocFinalReportQuestion[]

  @@index([tenantId])
  @@map("pocs")
}

// Fase 6 (add-on), Fase B: a short checklist agreed upfront with the customer - the roadmap's own
// benchmark research (Vivun/Dock/Recapped) flagged vague success criteria as the #1 cause of a
// POC that never ends, so this is deliberately just a description + done flag, not a scored
// rubric - simple enough that a presales engineer fills it out during kickoff, not after.
model PocSuccessCriterion {
  id          String   @id
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  pocId       String   @map("poc_id")
  poc         Poc      @relation(fields: [pocId], references: [id], onDelete: Cascade)
  description String
  done        Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([pocId])
  @@map("poc_success_criteria")
}

// Fase 6 (add-on), Fase C: physical hardware loaned to the customer for the POC. No shared
// inventory across POCs by design (product decision, 2026-07-13) - each POC only tracks what it
// itself shipped. The two invoice attachments reuse the storage adapter (server/utils/storage.ts)
// directly, not the Document table - Document.projectId is required, and a POC can be standalone
// with no Project at all.
model PocEquipmentItem {
  id           String             @id
  tenantId     String             @map("tenant_id")
  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  pocId        String             @map("poc_id")
  poc          Poc                @relation(fields: [pocId], references: [id], onDelete: Cascade)
  name         String
  serialNumber String?            @map("serial_number")
  status       PocEquipmentStatus @default(shipped)

  // Fase G: populated when the item was imported from the linked Project's BOM instead of typed
  // manually - manufacturer/partNumber travel with it since the BOM already has them, and
  // sourceBomItemId (the BOMItem.item_id, not a DB foreign key - the BOM itself is a JSON blob on
  // AnalysisResult, not a table) is how "already imported" candidates get filtered out of the
  // picker on a second visit.
  manufacturer    String? @map("manufacturer")
  partNumber      String? @map("part_number")
  sourceBomItemId String? @map("source_bom_item_id")

  // Fase G: cached count from the last dbStore.searchApprovedKnowledgeBase() run against this
  // item's name/manufacturer (same IDF-weighted search BOM enrichment already uses) - just enough
  // for the UI badge ("3 entradas encontradas"). Fase H re-runs the real search fresh at
  // generation time rather than trusting this cached number, so it never goes stale in a way that
  // matters - this field existing at all is a UI nicety, not the source of truth.
  kbMatchCount Int @default(0) @map("kb_match_count")

  // Fase G: the datasheet becomes a real, reusable KnowledgeBaseDocument (same upload/analyze
  // pipeline as the general Base de Conhecimento screen) rather than a private attachment on this
  // one POC - onDelete: SetNull because deleting the equipment item should never delete
  // knowledge other POCs/analyses may already depend on.
  datasheetKnowledgeBaseDocumentId String?                @map("datasheet_knowledge_base_document_id")
  datasheetDocument                KnowledgeBaseDocument? @relation(fields: [datasheetKnowledgeBaseDocumentId], references: [id], onDelete: SetNull)

  shippingInvoiceStorageProvider  StorageProvider? @map("shipping_invoice_storage_provider")
  shippingInvoiceStoragePath      String?          @map("shipping_invoice_storage_path")
  shippingInvoiceOriginalFilename String?          @map("shipping_invoice_original_filename")
  returnInvoiceStorageProvider    StorageProvider? @map("return_invoice_storage_provider")
  returnInvoiceStoragePath        String?          @map("return_invoice_storage_path")
  returnInvoiceOriginalFilename   String?          @map("return_invoice_original_filename")

  // Fase I: when a tracking code is set, real carrier tracking (Site Rastreio) drives `status`
  // instead of the NF upload - the NF becomes just the fiscal proof/document (product decision,
  // 2026-07-13). trackingCarrierStatus caches the literal carrier text (e.g. "Objeto entregue ao
  // destinatário") shown as-is in the UI, never translated into our own Enviado/Na casa do
  // cliente/Devolvido vocabulary.
  trackingCode          String?   @map("tracking_code")
  trackingCarrierStatus String?   @map("tracking_carrier_status")
  trackingLastCheckedAt DateTime? @map("tracking_last_checked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([pocId])
  @@index([datasheetKnowledgeBaseDocumentId])
  @@map("poc_equipment_items")
}

// Fase 6 (add-on), Fase D: single-predecessor dependency chain (FS - finish-to-start), not a full
// multi-predecessor graph - covers the common linear/branching case the approved mockup was built
// against without the extra modeling weight of a join table. Critical path is computed on the
// frontend (small graph, no need to persist it) by walking these dependsOnTaskId chains.
model PocTask {
  id              String        @id
  tenantId        String        @map("tenant_id")
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  pocId           String        @map("poc_id")
  poc             Poc           @relation(fields: [pocId], references: [id], onDelete: Cascade)
  name            String
  startDate       DateTime      @map("start_date")
  durationDays    Int           @default(1) @map("duration_days")
  status          PocTaskStatus @default(planned)
  dependsOnTaskId String?       @map("depends_on_task_id")
  dependsOnTask   PocTask?      @relation("PocTaskDependency", fields: [dependsOnTaskId], references: [id], onDelete: SetNull)
  dependents      PocTask[]     @relation("PocTaskDependency")
  // Fase H: same "IA rascunha, humano valida" regeneration safety as PocTestCase - a
  // "Sugerir cronograma com IA" can freely replace tasks nobody has touched, never ones a human
  // created from scratch or edited.
  generatedByAi   Boolean       @default(false) @map("generated_by_ai")
  editedManually  Boolean       @default(false) @map("edited_manually")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([pocId])
  @@map("poc_tasks")
}

// Fase 6 (add-on), Fase E: test cases generated from the POC's objective/success criteria via the
// AI orchestrator (poc_test_generation task type), same "IA rascunha, humano valida" pattern
// already used in the Proposal Studio - regenerable and editable, not a one-shot frozen record.
model PocTestCase {
  id             String            @id
  tenantId       String            @map("tenant_id")
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  pocId          String            @map("poc_id")
  poc            Poc               @relation(fields: [pocId], references: [id], onDelete: Cascade)
  code           String
  title          String
  objective      String            @db.Text
  steps          String            @db.Text
  expectedResult String            @map("expected_result") @db.Text
  status         PocTestCaseStatus @default(pending)
  generatedByAi  Boolean           @default(false) @map("generated_by_ai")
  editedManually Boolean           @default(false) @map("edited_manually")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([pocId])
  @@map("poc_test_cases")
}

// Fase 6 (add-on), Fase F: final decision record (ganha/perdida) plus a manual placeholder for the
// signed acceptance document - deliberately not a real e-signature integration yet (product
// decision, 2026-07-13, left open for a future session), just upload of an already-signed file.
model PocAcceptance {
  id                             String                @id
  tenantId                       String                @map("tenant_id")
  tenant                         Tenant                @relation(fields: [tenantId], references: [id])
  pocId                          String                @unique @map("poc_id")
  poc                            Poc                   @relation(fields: [pocId], references: [id], onDelete: Cascade)
  decision                       PocAcceptanceDecision @default(pending)
  signedDocumentStorageProvider  StorageProvider?      @map("signed_document_storage_provider")
  signedDocumentStoragePath      String?               @map("signed_document_storage_path")
  signedDocumentOriginalFilename String?               @map("signed_document_original_filename")
  signedBy                       String?               @map("signed_by")
  signedAt                       DateTime?             @map("signed_at")
  notes                          String?               @db.Text

  // Fase L: "Finalizar" (requires the mandatory final report complete + a won/lost decision
  // selected) puts the POC into this gate rather than jumping straight to Poc.status = "completed"
  // - a real approval step, not just a label. Only "Aprovar" (poc:manage) flips Poc.status and
  // clears this.
  pendingApproval  Boolean   @default(false) @map("pending_approval")
  approvedByUserId String?   @map("approved_by_user_id")
  approvedAt       DateTime? @map("approved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("poc_acceptances")
}

// Fase M: mandatory questionnaire generated by AI (poc_final_report_generation task) from the
// POC's objective/success criteria/test cases/Knowledge Base grounding, answered by the presales
// engineer with the real observed outcome - same "IA rascunha, humano valida" regeneration safety
// as PocTestCase/PocTask (generatedByAi/editedManually + a delete-unedited-drafts helper), except
// here what a human "edits" is filling in `answer` (the question itself is what's AI-authored).
model PocFinalReportQuestion {
  id             String   @id
  tenantId       String   @map("tenant_id")
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  pocId          String   @map("poc_id")
  poc            Poc      @relation(fields: [pocId], references: [id], onDelete: Cascade)
  question       String   @db.Text
  answer         String?  @db.Text
  order          Int      @default(0)
  generatedByAi  Boolean  @default(false) @map("generated_by_ai")
  editedManually Boolean  @default(false) @map("edited_manually")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([pocId])
  @@map("poc_final_report_questions")
}

model Document {
  id                         String          @id
  tenantId                   String          @map("tenant_id")
  tenant                     Tenant          @relation(fields: [tenantId], references: [id])
  projectId                  String          @map("project_id")
  project                    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filename                   String
  originalFilename           String          @map("original_filename")
  mimeType                   String          @map("mime_type")
  fileSize                   Int             @map("file_size")
  storageProvider            StorageProvider @map("storage_provider")
  storagePath                String          @map("storage_path")
  detectedDocumentType       String          @map("detected_document_type")
  manualDocumentType         String?         @map("manual_document_type")
  aiClassificationConfidence Float           @map("ai_classification_confidence")
  version                    Int
  language                   String
  // Not a User FK: some call sites store a display name here instead of a user id.
  uploadedBy                 String          @map("uploaded_by")
  createdAt                  DateTime        @default(now()) @map("created_at")

  content DocumentContent?

  @@index([tenantId])
  @@map("documents")
}

model DocumentContent {
  documentId String   @id @map("document_id")
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String   @db.Text

  @@index([tenantId])
  @@map("document_contents")
}

model BackgroundTask {
  id                 String               @id
  tenantId           String               @map("tenant_id")
  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  // Nullable only for type=system_update triggered by a schedule or a CMSaaS apply_update
  // command - neither has a live HTTP request/session behind it, unlike every other task type
  // (and every other trigger of a system_update itself: an admin clicking "Atualizar Agora" still
  // sets this normally).
  userId             String?              @map("user_id")
  type               BackgroundTaskType
  status             BackgroundTaskStatus @default(queued)
  currentStep        String               @map("current_step")
  progressPct        Int?                 @map("progress_pct")
  errorMessage       String?              @map("error_message") @db.Text
  // Non-fatal advisory shown alongside a *completed* task's result (e.g. "Base de Conhecimento
  // insuficiente para este equipamento") - deliberately separate from errorMessage, which is only
  // ever set on a failed task; a reader shouldn't have to wonder why a "completed" task carries an
  // "error".
  warningMessage     String?              @map("warning_message") @db.Text
  // Generic pointer to whatever the task produced (e.g. "analysis_result"/<project id>,
  // "proposal"/<proposal id>) - lets the frontend know what to fetch once status is completed,
  // without this table needing a column per possible result type.
  resultType         String?              @map("result_type")
  resultId           String?              @map("result_id")
  // Phase 5 (AI orchestrator): cost/provider bookkeeping for AI-calling task types
  // (document_analysis, project_intake_analysis). Null for task types that don't call an AI
  // provider at all (e.g. proposal_generation is template/DOCX filling, not its own AI call).
  estimatedCostUsd   Float?               @map("estimated_cost_usd")
  aiProvider         String?              @map("ai_provider")
  intendedProvider   String?              @map("intended_provider")
  isProviderFallback Boolean              @default(false) @map("is_provider_fallback")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([userId])
  @@map("background_tasks")
}

model AIAnalysisJob {
