model AnalysisResult {
  id        String        @id
  tenantId  String        @map("tenant_id")
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  projectId String        @map("project_id")
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobId     String        @map("job_id")
  job       AIAnalysisJob @relation(fields: [jobId], references: [id])

  // Semi-structured AI-generated content: shape evolves with prompt/model versions,
  // always read/written as a whole per project, never queried by sub-item elsewhere.
  executiveSummary       Json @map("executive_summary")
  criticalRequirements   Json @map("critical_requirements")
  risks                  Json
  opportunities          Json
  bom                    Json
  pointToPointTable      Json @map("point_to_point_table")
  preliminarySchedule    Json @map("preliminary_schedule")
  clarificationQuestions Json @map("clarification_questions")

  // Roadmap item (customer_request): staleness signal for hardcoded prompt/parsing logic (as
  // opposed to AIAnalysisJob.promptTemplateVersion, which only versions the admin-editable prompt
  // TEXT via PromptTemplate) - e.g. the ~5 real bugs fixed in enrichBomWithWebSearch's matching/
  // parsing logic this session had no way to mark already-saved AnalysisResult rows as outdated.
  // One key per hardcoded logic unit that writes to this row (see src/aiLogicVersions.ts),
  // e.g. { "document_analysis": 1, "bom_enrichment": 6 } - null on rows written before this
  // column existed, treated as "legacy/unknown" (distinct from both stale and up-to-date) rather
  // than flagged en masse on deploy.
  logicVersions Json? @map("logic_versions")

  technicalProposalDraft  String       @map("technical_proposal_draft") @db.Text
  commercialProposalDraft String       @map("commercial_proposal_draft") @db.Text
  reviewStatus            ReviewStatus @default(pending) @map("review_status")
  approvedBy              String?      @map("approved_by")
  approvedAt              DateTime?    @map("approved_at")
  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @updatedAt @map("updated_at")

  pricingSheets ProjectPricingSheet[]

  @@unique([projectId])
  @@index([tenantId])
  @@map("analysis_results")
