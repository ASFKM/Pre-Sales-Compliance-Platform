enum KnowledgeBaseEntryCategory {
  bom_part_number
  engineering_note
  compliance_status
  datasheet
}

enum KnowledgeBaseEntryStatus {
  pending
  approved
  rejected
}

enum KnowledgeBaseEntrySource {
  reactive_edit
  uploaded_document
  fleet_manager_global
}

// A document (manufacturer datasheet, technical catalog...) uploaded specifically to seed the
// Knowledge Base - deliberately not reusing the project-scoped Document model, since these have
// no project of origin. analyzedAt is null until "Analisar Documentos e Gerar Base de
// Conhecimento" has processed it at least once.
model KnowledgeBaseDocument {
  id               String          @id
  tenantId         String          @map("tenant_id")
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  filename         String
  originalFilename String          @map("original_filename")
  mimeType         String          @map("mime_type")
  fileSize         Int             @map("file_size")
  storageProvider  StorageProvider @map("storage_provider")
  storagePath      String          @map("storage_path")
  uploadedBy       String          @map("uploaded_by")
  analyzedAt       DateTime?       @map("analyzed_at")
  // sha256 do conteúdo do arquivo - detecta reupload do mesmo documento (caso real observado: o
  // mesmo datasheet enviado 4 vezes) para avisar antes de gerar entries redundantes de novo.
  contentHash      String?         @map("content_hash")
  createdAt        DateTime        @default(now()) @map("created_at")

  pocEquipmentItems PocEquipmentItem[]

  @@index([tenantId])
  @@index([tenantId, contentHash])
  @@map("knowledge_base_documents")
}

// A trigger/knowledge pair the AI can draw on in future analyses, sourced either from a human
// correcting the AI's own output (reactive_edit) or from a proactively-uploaded reference
// document (uploaded_document) - both land as `pending` and need human approval before
// getAnalysisContextEntries() (the retrieval side, used by the main analysis prompt) will ever
// surface them, so a bad AI-generated summary of an edit or a misread datasheet section can never
// silently become "fact" for a future project. source*Name fields are point-in-time snapshots
// (not live FK lookups) so an entry stays meaningful even if its source project/document is later
// deleted.
model KnowledgeBaseEntry {
  id                 String                     @id
  tenantId           String                     @map("tenant_id")
  tenant             Tenant                     @relation(fields: [tenantId], references: [id])
  category           KnowledgeBaseEntryCategory
  trigger            String                     @db.Text
  knowledge          String                     @db.Text
  status             KnowledgeBaseEntryStatus   @default(pending)
  source             KnowledgeBaseEntrySource
  sourceProjectId    String?                    @map("source_project_id")
  sourceProjectName  String?                    @map("source_project_name")
  sourceDocumentId   String?                    @map("source_document_id")
  sourceDocumentName String?                    @map("source_document_name")
  createdBy          String                     @map("created_by")
  reviewedBy         String?                    @map("reviewed_by")
  createdAt          DateTime                   @default(now()) @map("created_at")
  reviewedAt         DateTime?                  @map("reviewed_at")
  // Set only when source = fleet_manager_global: the id of the PresalesKbEntry on the Fleet
  // Manager side this was delivered from - used to recognize a redelivered entry (heartbeat retry)
  // before its ack registers, so it's never created twice. Not @unique on its own: a single
  // physical install's database can host multiple tenants, each with its own Fleet Manager
  // connection (PlatformSettings is tenant-scoped), so two different tenants legitimately
  // receiving the same global entry is a real case, not a bug - lookups go through findFirst
  // (tenant-scoped automatically by src/prisma.ts), not findUnique.
  fleetGlobalEntryId String?                    @map("fleet_global_entry_id")
  // Set only for locally-created entries (reactive_edit/uploaded_document) once they've been
  // uploaded to the Fleet Manager on a heartbeat - see server/utils/fleetLicense.ts. Never set for
  // fleet_manager_global entries, which never sync back up.
  syncedToFleetAt    DateTime?                  @map("synced_to_fleet_at")
  // Métrica leve de uso - incrementada em searchApprovedKnowledgeBase sempre que a entry aparece
  // num resultado. Sem isso não dá pra identificar entries órfãs (nunca de fato aproveitadas por
  // nenhuma análise) entre as 587+ já cadastradas.
  matchCount         Int                        @default(0) @map("match_count")
  lastMatchedAt      DateTime?                  @map("last_matched_at")

  @@index([tenantId])
  @@index([status])
  @@map("knowledge_base_entries")
}

// Single source of truth for AI spend, independent of BackgroundTask - several AI-calling paths
// (copilot chat, BOM web-search enrichment, Knowledge Base suggest/analyze, document
// classification) are fast synchronous calls, not long-running background jobs, so tracking cost
// only on BackgroundTask.estimatedCostUsd left them uncapped and uncounted. One row per AI call
// that completed, real cost or not. backgroundTaskId is set when the call happened inside a
// tracked job, for traceability - not a hard FK, since the referenced task or the row itself may
// outlive the other independently.
model AiUsageLog {
  id               String   @id
  tenantId         String   @map("tenant_id")
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  taskType         String   @map("task_type")
  provider         String
  model            String
  estimatedCostUsd Float    @map("estimated_cost_usd")
  backgroundTaskId String?  @map("background_task_id")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("ai_usage_logs")
}

// User-added AI provider, on top of the 3 built-in ones (Gemini/OpenAI/Anthropic). Any provider
// exposing an OpenAI-compatible chat completions endpoint works here with no code change - this
// covers Grok/xAI, DeepSeek, Mistral AI, Groq, Together AI, Fireworks, and OpenRouter as of the
// research behind this feature (all mirror the OpenAI request/response shape, including JSON
// mode). providerKey is what gets stored in the *_provider task-routing fields (e.g. "grok").
model AiProviderConfig {
  id                String   @id
  tenantId          String   @map("tenant_id")
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  providerKey       String   @map("provider_key")
  displayName       String   @map("display_name")
  baseUrl           String   @map("base_url")
  apiKeyEncrypted   String   @map("api_key_encrypted")
  defaultModel      String   @map("default_model")
  // AI Orchestrator UI redesign (2026-07): self-declared capability flags, admin-set when adding
  // the provider - lets a custom provider that genuinely supports vision/PDF input or has native
  // web search (e.g. Perplexity Sonar, which always grounds its answers in a real web search, no
  // opt-in tool parameter needed) show up as a valid choice for those orchestrator tasks, instead
  // of every custom provider being treated as text-only by default.
  supportsVision    Boolean  @default(false) @map("supports_vision")
  supportsWebSearch Boolean  @default(false) @map("supports_web_search")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([tenantId, providerKey])
  @@map("ai_provider_configs")
}

// ---------------------------------------------------------------------------------------------
// Módulo de Precificação (add-on) - Fase 1 do plano de implementação. Ver o desenho completo em
// Basic Memory (presales/pricing-module) e no plano em /home/sakae/.claude/plans/velvet-soaring-
// hearth.md. Campos do motor fiscal (icmsRatePercent etc.) já existem aqui mas ficam sempre null/
// não usados até a Fase 7 (TenantPricingSettings.taxCalculationEnabled) implementar o cálculo -
// evita uma segunda migration nas mesmas tabelas quando essa fase chegar.
// ---------------------------------------------------------------------------------------------

enum PriceItemType {
  merchandise
  service
}

enum PriceListUploadStatus {
  processing
  completed
  failed
}

enum PricingMatchStatus {
  matched
  manual
  unmatched
}

enum PricingSheetStatus {
  draft
  finalized
}

// O cadastro "vivo" de um item - sempre reflete o preço/markup atual. Histórico real fica em
// PriceHistoryEntry (ledger append-only), nunca sobrescrito.
model PriceCatalogItem {
  id               String         @id
  tenantId         String         @map("tenant_id")
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  itemCode         String         @map("item_code")
  // Código no ERP/SAP do cliente - referência genérica pra integração futura, não usado em
  // nenhum matching interno hoje (pedido explícito do usuário, distinto do itemCode interno).
  erpCode          String?        @map("erp_code")
  // Classificação fiscal (NCM) - só relevante com o motor fiscal da Fase 7 ligado.
  ncmCode          String?        @map("ncm_code")
  itemType         PriceItemType? @map("item_type")
  category         String
  pn               String
  description      String         @db.Text
  currentListPrice Float          @map("current_list_price")
  currency         String         @default("BRL")
  markupMin        Float          @map("markup_min")
  markupMax        Float          @map("markup_max")
  ipiRatePercent   Float?         @map("ipi_rate_percent")
  issRatePercent   Float?         @map("iss_rate_percent")
  stApplicable     Boolean        @default(false) @map("st_applicable")
  vendor           String?
  active           Boolean        @default(true)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  priceHistoryEntries PriceHistoryEntry[]
  aliasMappings       ItemAliasMapping[]
  pricingLines        ProjectPricingLine[]

  @@unique([tenantId, itemCode])
  @@index([tenantId])
  @@index([tenantId, pn])
  @@map("price_catalog_items")
}

// Cada envio de planilha vira um lote com vigência própria - a tabela de preços nunca é
// "substituída", só ganha um novo lote (ver PriceHistoryEntry).
model PriceListUpload {
  id               String                @id
  tenantId         String                @map("tenant_id")
  tenant           Tenant                @relation(fields: [tenantId], references: [id])
  uploadedByUserId String                @map("uploaded_by_user_id")
  uploadedBy       User                  @relation(fields: [uploadedByUserId], references: [id])
  uploadedAt       DateTime              @default(now()) @map("uploaded_at")
  fileName         String                @map("file_name")
  effectiveDate    DateTime              @map("effective_date")
  status           PriceListUploadStatus @default(processing)
  sourceLabel      String?               @map("source_label")

  historyEntries PriceHistoryEntry[]

  @@index([tenantId])
  @@map("price_list_uploads")
}

// Ledger append-only por item/upload - nunca é atualizado depois de criado, é isso que alimenta
// o gráfico de evolução de preço por linha.
model PriceHistoryEntry {
  id                String           @id
  tenantId          String           @map("tenant_id")
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  priceListUploadId String           @map("price_list_upload_id")
  priceListUpload   PriceListUpload  @relation(fields: [priceListUploadId], references: [id], onDelete: Cascade)
  itemId            String           @map("item_id")
  item              PriceCatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  listPrice         Float            @map("list_price")
  currency          String
  markupMin         Float            @map("markup_min")
  markupMax         Float            @map("markup_max")
  effectiveDate     DateTime         @map("effective_date")
  createdAt         DateTime         @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([itemId])
  @@map("price_history_entries")
}

// Resolve PN -> item cadastrado, e funciona como fila de pendências: enquanto resolvedItemId for
// null, é um item visto num BOM que ainda não tem preço cadastrado (ver Fase 5 - ciclo de
// exportação/reenvio). timesSeen prioriza o que mais aparece em BOMs diferentes.
model ItemAliasMapping {
  id             String            @id
  tenantId       String            @map("tenant_id")
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  rawPN          String            @map("raw_pn")
  rawDescription String?           @map("raw_description")
  resolvedItemId String?           @map("resolved_item_id")
  resolvedItem   PriceCatalogItem? @relation(fields: [resolvedItemId], references: [id], onDelete: SetNull)
  firstSeenAt    DateTime          @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime          @updatedAt @map("last_seen_at")
  timesSeen      Int               @default(1) @map("times_seen")

  @@unique([tenantId, rawPN])
  @@index([tenantId])
  @@map("item_alias_mappings")
}

// A "sessão de precificação" de um projeto - criada ao importar o BOM da AnalysisResult do
// projeto (Fase 4). destinationUF/destinationTaxpayerType/targetBudgetBasis só são usados com o
// motor fiscal da Fase 7 ligado.
model ProjectPricingSheet {
  id                      String             @id
  tenantId                String             @map("tenant_id")
  tenant                  Tenant             @relation(fields: [tenantId], references: [id])
  projectId               String             @map("project_id")
  project                 Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceAnalysisResultId  String             @map("source_analysis_result_id")
  sourceAnalysisResult    AnalysisResult     @relation(fields: [sourceAnalysisResultId], references: [id])
  targetBudget            Float?             @map("target_budget")
  targetBudgetBasis       String?            @map("target_budget_basis")
  destinationUF           String?            @map("destination_uf")
  destinationTaxpayerType String?            @map("destination_taxpayer_type")
  status                  PricingSheetStatus @default(draft)
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")

  lines      ProjectPricingLine[]
  budgetRuns BudgetOptimizationRun[]

  @@index([tenantId])
  @@index([projectId])
  @@map("project_pricing_sheets")
}

// Cada linha do BOM importado dentro da sessão. bomItemId referencia BOMItem.item_id do JSON em
// AnalysisResult.bom - SEM FK real, mesmo padrão já usado por
// PocEquipmentItem.sourceBomItemId (a BOM é um blob JSON, não uma tabela).
model ProjectPricingLine {
  id                String              @id
  tenantId          String              @map("tenant_id")
  tenant            Tenant              @relation(fields: [tenantId], references: [id])
  pricingSheetId    String              @map("pricing_sheet_id")
  pricingSheet      ProjectPricingSheet @relation(fields: [pricingSheetId], references: [id], onDelete: Cascade)
  bomItemId         String              @map("bom_item_id")
  rawPartNumber     String?             @map("raw_part_number")
  rawDescription    String?             @map("raw_description")
  matchedItemId     String?             @map("matched_item_id")
  matchedItem       PriceCatalogItem?   @relation(fields: [matchedItemId], references: [id], onDelete: SetNull)
  matchStatus       PricingMatchStatus  @default(unmatched) @map("match_status")
  quantity          Float
  listPriceSnapshot Float?              @map("list_price_snapshot")
  discountPercent   Float               @default(0) @map("discount_percent")
  finalUnitPrice    Float?              @map("final_unit_price")
  marginPercent     Float?              @map("margin_percent")

  // Motor fiscal (Fase 7) - null/não usados enquanto TenantPricingSettings.taxCalculationEnabled
  // for false.
  icmsRatePercent      Float?  @map("icms_rate_percent")
  ipiRatePercent       Float?  @map("ipi_rate_percent")
  pisCofinsRatePercent Float?  @map("pis_cofins_rate_percent")
  issRatePercent       Float?  @map("iss_rate_percent")
  stFlag               Boolean @default(false) @map("st_flag")
  totalTaxPercent      Float?  @map("total_tax_percent")
  finalPriceWithTax    Float?  @map("final_price_with_tax")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([pricingSheetId])
  @@map("project_pricing_lines")
}

// Auditoria de cada rodada de "chegar no budget" (Fase 6) - separa ajuste automático (IA) de
// ajuste manual subsequente do usuário. resultSummary guarda o antes/depois por linha.
model BudgetOptimizationRun {
  id                String              @id
  tenantId          String              @map("tenant_id")
  tenant            Tenant              @relation(fields: [tenantId], references: [id])
  pricingSheetId    String              @map("pricing_sheet_id")
  pricingSheet      ProjectPricingSheet @relation(fields: [pricingSheetId], references: [id], onDelete: Cascade)
  targetBudget      Float               @map("target_budget")
  strategy          String
  requestedByUserId String              @map("requested_by_user_id")
  requestedBy       User                @relation(fields: [requestedByUserId], references: [id])
  createdAt         DateTime            @default(now()) @map("created_at")
  resultSummary     Json                @map("result_summary")

  @@index([tenantId])
  @@index([pricingSheetId])
  @@map("budget_optimization_runs")
}

// Configuração do módulo por tenant. Hoje só o toggle do motor fiscal (Fase 7, default
// desligado - muitos tenants já calculam imposto no próprio ERP, ver decisão do usuário).
model TenantPricingSettings {
  id                    String   @id
  tenantId              String   @map("tenant_id")
  tenant                Tenant   @relation(fields: [tenantId], references: [id])
  taxCalculationEnabled Boolean  @default(false) @map("tax_calculation_enabled")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@unique([tenantId])
  @@map("tenant_pricing_settings")
}

enum TaxRegime {
  simples_nacional
  lucro_presumido
  lucro_real
}

// Fase 7: perfil fiscal do vendedor - só relevante com TenantPricingSettings.taxCalculationEnabled
// ligado.
model TenantTaxProfile {
  id                    String    @id
  tenantId              String    @unique @map("tenant_id")
  tenant                Tenant    @relation(fields: [tenantId], references: [id])
  originUF              String    @map("origin_uf")
  taxRegime             TaxRegime @map("tax_regime")
  simplesAnexo          String?   @map("simples_anexo")
  simplesRevenueBracket String?   @map("simples_revenue_bracket")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("tenant_tax_profiles")
}

// Fase 7: tabela de referência CONFAZ (alíquota interestadual de ICMS) - NÃO é por tenant, é regra
// federal. Mantida como tabela editável em vez de constante no código porque legislação muda.
model IcmsInterstateRateTable {
  id            String @id
  originUF      String @map("origin_uf")
  destinationUF String @map("destination_uf")
  ratePercent   Float  @map("rate_percent")

  @@unique([originUF, destinationUF])
  @@map("icms_interstate_rate_table")
}
