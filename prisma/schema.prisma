// Cached mirror of this tenant's ia_kb add-on billing state, refreshed on every Fleet Manager
// heartbeat (server/utils/fleetLicense.ts) - the only channel to the Fleet Manager an on-prem
// installation has (it can sit behind a firewall/NAT, so the Admin Console can't call the Fleet
// Manager live on page load). Deliberately carries no real provider cost, only the value already
// marked up (product decision, 2026-07-14) - the Fleet Manager's own heartbeat response never
// sends real cost either, so there's nothing sensitive to leak even if this table were read
// directly.
model IaKbBillingSnapshot {
  id                 String    @id
  tenantId           String    @unique @map("tenant_id")
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  markupPercent      Float     @map("markup_percent")
  cycleStart         DateTime? @map("cycle_start")
  cycleBilledCostUsd Float     @map("cycle_billed_cost_usd")
  cycleCallCount     Int       @map("cycle_call_count")
  nextDueDate        DateTime? @map("next_due_date")
  lastSyncedAt       DateTime  @map("last_synced_at")

  @@map("iakb_billing_snapshots")
}

// Per-task provider/model choice synced from the Fleet Manager once the ia_kb add-on is enabled -
// resolveProvider() (src/aiOrchestrator.ts) overrides platform_settings' own per-task fields with
// these when present, since the CMSaaS admin - not the tenant - now controls that choice. Refreshed
// on every heartbeat (server/utils/fleetLicense.ts) via a full replace (delete-then-recreate for
// this tenant), not a per-row upsert - the Fleet Manager always sends its complete current set, so
// a row that existed before but is no longer sent (e.g. a task the admin never configured) should
// disappear here too, not linger as a stale override.
model IaKbTaskConfig {
  id        String   @id
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  taskType  String   @map("task_type")
  provider  String
  model     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, taskType])
  @@map("iakb_task_configs")
}

model PlatformSettings {
  id                                String          @id
  tenantId                          String          @map("tenant_id")
  tenant                            Tenant          @relation(fields: [tenantId], references: [id])
  aiProvider                        String          @map("ai_provider")
  defaultModel                      String          @map("default_model")
  documentAnalysisModel             String          @map("document_analysis_model")
  proposalGenerationModel           String          @map("proposal_generation_model")
  aiApiKeyEncrypted                 String?         @map("ai_api_key_encrypted") @db.Text
  openaiApiKeyEncrypted             String?         @map("openai_api_key_encrypted") @db.Text
  anthropicApiKeyEncrypted          String?         @map("anthropic_api_key_encrypted") @db.Text
  // Phase 5 (AI orchestrator): which provider is the intended target for each task type,
  // researched per-task (docs/roadmap/REDESIGN_ROADMAP_2026-07.md). gemini/openai/anthropic are
  // all really connected (see resolveProvider in src/aiOrchestrator.ts) - a task still falls back
  // to gemini, logged as such, only if its intended provider's key isn't actually configured.
  documentAnalysisProvider          String          @default("gemini") @map("document_analysis_provider")
  criticalExtractionModel           String          @default("gemini-3.5-flash") @map("critical_extraction_model")
  criticalExtractionProvider        String          @default("anthropic") @map("critical_extraction_provider")
  webGroundingModel                 String          @default("gemini-3.5-flash") @map("web_grounding_model")
  webGroundingProvider              String          @default("gemini") @map("web_grounding_provider")
  proposalGenerationProvider        String          @default("anthropic") @map("proposal_generation_provider")
  specCopilotModel                  String          @default("gemini-3.5-flash") @map("spec_copilot_model")
  specCopilotProvider               String          @default("gemini") @map("spec_copilot_provider")
  // AI Orchestrator UI redesign (2026-07): document_classification was previously hardcoded to
  // Gemini in server/utils/documentClassification.ts, bypassing the orchestrator entirely - now
  // routed through resolveProvider() like the other real task types.
  documentClassificationModel       String          @default("gemini-3.5-flash") @map("document_classification_model")
  documentClassificationProvider    String          @default("gemini") @map("document_classification_provider")
  // Fase 6 (add-on), Fase E: test scripts generated from a POC's objective/success criteria -
  // pure text-in/text-out, same orchestrator pattern as the 4 task types above.
  pocTestGenerationModel            String          @default("gemini-3.5-flash") @map("poc_test_generation_model")
  pocTestGenerationProvider         String          @default("gemini") @map("poc_test_generation_provider")
  // Fase H (add-on): schedule suggestion from a POC's objective + linked equipment's Knowledge
  // Base grounding - same orchestrator pattern as poc_test_generation above.
  pocScheduleGenerationModel        String          @default("gemini-3.5-flash") @map("poc_schedule_generation_model")
  pocScheduleGenerationProvider     String          @default("gemini") @map("poc_schedule_generation_provider")
  // Fase M (add-on): mandatory final-report questionnaire generation - same orchestrator pattern.
  pocFinalReportGenerationModel     String          @default("gemini-3.5-flash") @map("poc_final_report_generation_model")
  pocFinalReportGenerationProvider  String          @default("gemini") @map("poc_final_report_generation_provider")
  // Item 3 roadmap (official): "Pareceres de IA Multi-Perspectiva em Propostas" - one shared
  // provider/model slot for all 4 opinion perspectives (not 4 separate slots) - see the roadmap
  // decision already confirmed: 1 task type, not 4, to minimize sync points.
  proposalOpinionPanelModel         String          @default("gemini-3.5-flash") @map("proposal_opinion_panel_model")
  proposalOpinionPanelProvider      String          @default("gemini") @map("proposal_opinion_panel_provider")
  pricingBudgetOptimizationModel    String          @default("gemini-3.5-flash") @map("pricing_budget_optimization_model")
  pricingBudgetOptimizationProvider String          @default("gemini") @map("pricing_budget_optimization_provider")
  // Per-tenant monthly AI spend cap - null means uncapped. Enforced (hard block once reached,
  // not just tracked), with an 80%-of-cap warning logged before that point.
  monthlyCostCapUsd                 Float?          @map("monthly_cost_cap_usd")
  // Phase 7 (fleet/license management): this installation's connection to the vendor's fleet
  // manager (a separate server - see docs/roadmap). Empty/disabled means no heartbeat runs and
  // the installation is always treated as active (fail-open) - matches the on-prem reality of
  // not every install necessarily being registered yet.
  fleetManagerUrl                   String?         @map("fleet_manager_url")
  fleetManagerApiKeyEncrypted       String?         @map("fleet_manager_api_key_encrypted") @db.Text
  fleetManagerEnabled               Boolean         @default(false) @map("fleet_manager_enabled")
  storageMode                       StorageProvider @default(local) @map("storage_mode")
  localStoragePath                  String          @map("local_storage_path")
  s3Bucket                          String          @map("s3_bucket")
  s3Region                          String?         @map("s3_region")
  s3AccessKeyId                     String?         @map("s3_access_key_id")
  s3SecretAccessKeyEncrypted        String?         @map("s3_secret_access_key_encrypted") @db.Text
  gcsBucket                         String          @map("gcs_bucket")
  gcsProjectId                      String?         @map("gcs_project_id")
  gcsServiceAccountKeyEncrypted     String?         @map("gcs_service_account_key_encrypted") @db.Text
  defaultLanguage                   Language        @map("default_language")
  defaultLogLevel                   LogLevel        @map("default_log_level")
  createdAt                         DateTime        @default(now()) @map("created_at")
  updatedAt                         DateTime        @updatedAt @map("updated_at")

  @@unique([tenantId])
  @@map("platform_settings")
}

enum SystemUpdateAttemptStatus {
  none
  in_progress
  success
  failed
  rolled_back
}

enum SystemUpdateTrigger {
  scheduled
  manual
  remote_command
}

// Sistema de Atualização de Produção: one row per tenant (singleton, like PlatformSettings just
// above) even though a real update restarts the whole server process and affects every tenant on
// it - kept tenant-scoped anyway because that's the same unit the CMSaaS connection itself is
// keyed to (see runHeartbeatForTenant in fleetLicense.ts: apiKey, latest_release, and apply_update
// commands all arrive per-tenant, not per-process). In the common case there's exactly one enabled
// tenant per Presales installation, so this is a singleton in practice.
model SystemUpdateState {
  id       String @id
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  currentVersion String?   @map("current_version")
  currentGitSha  String?   @map("current_git_sha")
  lastCheckedAt  DateTime? @map("last_checked_at")

  // Cached from the heartbeat's latest_release field (see heartbeat handling in fleetLicense.ts) -
  // release_notes_md is fetched separately, on demand, only when an admin opens the Atualizações
  // screen (GET /api/releases/:id on the CMSaaS side), not on every heartbeat.
  latestReleaseId          String?   @map("latest_release_id")
  latestReleaseVersion     String?   @map("latest_release_version")
  latestReleaseChannel     String?   @map("latest_release_channel")
  latestReleaseCodeRef     String?   @map("latest_release_code_ref")
  latestReleasePublishedAt DateTime? @map("latest_release_published_at")
  latestReleaseNotesMd     String?   @map("latest_release_notes_md") @db.Text

  // Frozen at the moment of scheduling - does NOT silently follow a newer release that appears
  // later; rescheduling to pick up a newer release is an explicit admin action.
  scheduledUpdateAt  DateTime? @map("scheduled_update_at")
  scheduledReleaseId String?   @map("scheduled_release_id")
  scheduledCodeRef   String?   @map("scheduled_code_ref")

  lastAttemptStatus          SystemUpdateAttemptStatus @default(none) @map("last_attempt_status")
  lastAttemptStartedAt       DateTime?                 @map("last_attempt_started_at")
  lastAttemptFinishedAt      DateTime?                 @map("last_attempt_finished_at")
  lastAttemptFromVersion     String?                   @map("last_attempt_from_version")
  lastAttemptToVersion       String?                   @map("last_attempt_to_version")
  lastAttemptErrorLog        String?                   @map("last_attempt_error_log") @db.Text
  lastAttemptErrorReportedAt DateTime?                 @map("last_attempt_error_reported_at")
  backupRef                  String?                   @map("backup_ref")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId])
  @@map("system_update_state")
}

// Append-only, one row per attempt (mirrors InstallationMetric's own append-only convention on
// the CMSaaS side) - SystemUpdateState above only ever holds the LATEST attempt, this is the full
// ledger the Admin Console's history panel reads.
model SystemUpdateHistory {
  id       String @id
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  fromVersion String? @map("from_version")
  toVersion   String  @map("to_version")
  fromCodeRef String? @map("from_code_ref")
  toCodeRef   String  @map("to_code_ref")
  releaseId   String? @map("release_id")

  startedAt   DateTime                  @map("started_at")
  finishedAt  DateTime?                 @map("finished_at")
  status      SystemUpdateAttemptStatus
  triggeredBy SystemUpdateTrigger       @map("triggered_by")

  errorLog         String? @map("error_log") @db.Text
  backupRef        String? @map("backup_ref")
  // Points at the BackgroundTask row driving the actual scripts/update.sh run, so the Admin
  // Console can reuse the same generic progress-tracking UI/polling every other task type uses.
  backgroundTaskId String? @map("background_task_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("system_update_history")
}

model PromptTemplate {
  id        String   @id
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  type      String
  content   String   @db.Text
  language  Language
  version   String
  isActive  Boolean  @default(true) @map("is_active")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // One row per version now (was implicitly one row per type, mutated in place - version was
  // decorative). Only one row per (type, version) - and, enforced in code rather than the
  // database (Postgres has no easy partial-unique-per-group-with-boolean-flag syntax here),
  // only one isActive:true row per type at a time.
  @@unique([tenantId, type, version])
  @@index([tenantId])
  @@map("prompt_templates")
}

model ProposalTemplate {
  id              String               @id
  tenantId        String               @map("tenant_id")
  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  name            String
  description     String
  templateType    ProposalTemplateType @map("template_type")
  language        Language
  fileType        ProposalFileType     @map("file_type")
  filePath        String               @map("file_path")
  // Which adapter actually wrote filePath - needed so a later storage_mode change on the tenant
  // doesn't cause deletes/reads of pre-existing templates to hit the wrong backend.
  storageProvider StorageProvider      @default(local) @map("storage_provider")
  variablesSchema String               @map("variables_schema") @db.Text
  version         String
  active          Boolean              @default(true)
  defaultTemplate Boolean              @default(false) @map("default_template")
  uploadedBy      String               @map("uploaded_by")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  proposals Proposal[]

  @@index([tenantId])
  @@map("proposal_templates")
}

enum SystemMessageSource {
  fleet_manager
  local
}

enum SystemMessageAudience {
  admin_only
  all_users
}

// Notices shown in-app - either relayed from the Fleet Manager over the heartbeat channel
// (source=fleet_manager, fleetMessageId set so a re-delivered message doesn't get duplicated) or
// created locally by this installation's own super admin (source=local).
model SystemMessage {
  id             String                @id
  tenantId       String                @map("tenant_id")
  tenant         Tenant                @relation(fields: [tenantId], references: [id])
  source         SystemMessageSource
  fleetMessageId String?               @unique @map("fleet_message_id")
  audience       SystemMessageAudience @default(all_users)
  body           String                @db.Text
  createdBy      String                @map("created_by")
  createdAt      DateTime              @default(now()) @map("created_at")
  // Null = never expires. For source=fleet_manager this is relayed as-is from the FleetMessage;
  // for source=local it's set from the duration chosen when the super admin composed it.
  expiresAt      DateTime?             @map("expires_at")

  @@index([tenantId])
  @@map("system_messages")
}

// Admin-managed list of industry verticals offered when creating a project - used to be a fixed
// 5-option hardcoded <select>, no way to add one without a code change.
model Vertical {
  id        String   @id
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("verticals")
}

model Proposal {
  id                    String           @id
  tenantId              String           @map("tenant_id")
  tenant                Tenant           @relation(fields: [tenantId], references: [id])
  projectId             String           @map("project_id")
  project               Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proposalType          ProposalType     @map("proposal_type")
  templateId            String           @map("template_id")
  template              ProposalTemplate @relation(fields: [templateId], references: [id])
  templateVersion       String           @map("template_version")
  status                ProposalStatus   @default(draft)
  language              Language
  docxFilePath          String           @map("docx_file_path")
  pdfFilePath           String           @map("pdf_file_path")
  storageProvider       StorageProvider  @default(local) @map("storage_provider")
  generatedBy           String           @map("generated_by")
  generatedAt           DateTime         @default(now()) @map("generated_at")
  version               Int
  approvalWorkflowId    String           @map("approval_workflow_id")
  approvalWorkflow      ApprovalWorkflow @relation(fields: [approvalWorkflowId], references: [id])
  manualPricingTable    Json?            @map("manual_pricing_table")
  paymentTerms          String?          @map("payment_terms") @db.Text
  deliveryTerms         String?          @map("delivery_terms") @db.Text
  proposalValidity      String?          @map("proposal_validity")
  commercialAssumptions String?          @map("commercial_assumptions") @db.Text
  exclusions            String?          @db.Text
  // Full editable proposal text, pre-filled from the analysis data at generation time - the
  // user can rewrite any section before submitting for approval. The DOCX/PDF are (re)generated
  // from this field, not directly from the raw analysis JSON, once it exists.
  editableContent       String?          @map("editable_content") @db.Text
  // Points at the most recent ProposalOpinionRun for this proposal - avoids an ORDER BY on every
  // read. Nullable: most proposals will never have a run.
  latestOpinionRunId    String?          @map("latest_opinion_run_id")

  decisions   ApprovalDecision[]
  opinionRuns ProposalOpinionRun[]

  @@index([tenantId])
  @@map("proposals")
}

// Roadmap item (official): "Pareceres de IA Multi-Perspectiva em Propostas" - never a gate that
// blocks the proposal signing flow (this product's AI is always consultative, never applies
// anything on its own) - a run's 4 opinions are purely informational context for the human
// approver, surfaced before ApprovalWorkflow's existing human stages. A "run" (not 4 columns
// directly on Proposal) allows reprocessing without losing history, isolates a failure to one
// perspective (the other 3 stay usable - same spirit as ApprovalWorkflow -> ApprovalStage ->
// ApprovalDecision), and doesn't require touching Proposal again if a 5th perspective is added
// later.
model ProposalOpinionRun {
  id                String                  @id
  tenantId          String                  @map("tenant_id")
  tenant            Tenant                  @relation(fields: [tenantId], references: [id])
  proposalId        String                  @map("proposal_id")
  proposal          Proposal                @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  backgroundTaskId  String?                 @map("background_task_id")
  status            String // "pending" | "running" | "completed" | "partial" | "failed"
  requestedByUserId String                  @map("requested_by_user_id")
  // Same staleness-versioning pattern as AnalysisResult.logicVersions (src/aiLogicVersions.ts) -
  // this run's prompts are hardcoded logic too, so a saved run can go stale the same way.
  logicVersion      Int                     @map("logic_version")
  createdAt         DateTime                @default(now()) @map("created_at")
  completedAt       DateTime?               @map("completed_at")
  opinions          ProposalAiOpinionItem[]

  @@index([tenantId])
  @@index([proposalId])
  @@map("proposal_opinion_runs")
}

model ProposalAiOpinionItem {
  id           String             @id
  tenantId     String             @map("tenant_id")
  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  runId        String             @map("run_id")
  run          ProposalOpinionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  perspective  String // "technical" | "commercial" | "legal" | "financial"
  status       String // "completed" | "failed"
  severity     String? // "info" | "warning" | "critical"
  summary      String             @db.Text
  content      String             @db.Text
  raw          Json?
  providerUsed String?            @map("provider_used")
  modelUsed    String?            @map("model_used")
  createdAt    DateTime           @default(now()) @map("created_at")

  @@unique([runId, perspective])
  @@index([tenantId])
  @@map("proposal_ai_opinion_items")
}

model ApprovalWorkflow {
